      "identifier": "$@1",
      "description": "Name der zuletzt geladenen Symboltabelle",
      "type": "Alphanumeric Systems Variable"
    },
    "$@3": {
      "identifier": "$@3",
      "description": "Text eines identifizierten Textbezugspunktes (wird in ALT 3 und in der Textinformation gesetzt)",
      "type": "Alphanumeric Systems Variable"
    },
    "$@4": {
      "identifier": "$@4",
      "description": "Name der Digitizerzuordnung Tablett/Bildschirm",
      "type": "Alphanumeric Systems Variable"
    },
    "$@9": {
      "identifier": "$@9",
      "description": "leer",
      "type": "Alphanumeric Systems Variable"
    },
    "$@AWV": {
      "identifier": "$@AWV",
      "description": "letzte Texteingabe",
      "type": "Alphanumeric Systems Variable"
    },
    "$@BMH": {
      "identifier": "$@BMH",
      "description": "Info über Maßhilfslinien, wird bei der Funktion Bemaßungsinfo auf 1,2,3 bzw. 11,12,14 gesetzt, wenn die Maßhilfslinien ausgeblendet sind bzw. der Schalter Z-Bemaßung gesetzt ist.",
      "type": "Alphanumeric Systems Variable"
    }
  }
}
